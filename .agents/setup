#!/usr/bin/env bash
# Setup for a fresh Linux sandbox that a coding agent works in (an "orb"):
# Godot 4.7.2 (same pin as CI), the art-pack Python venv, and a Godot import so
# class_name scripts resolve. It also appends a short note about this sandbox
# to the agent's global notes file (~/.config/amp/AGENTS.md).
# Idempotent and non-interactive. Never starts a server or downloads the
# ~1.3 GB export templates (those are only for a macOS .app).
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

GODOT_VERSION="4.7.2-stable"
GODOT_LINUX_SHA512="9aa00f7a605200940bce3027a567b782f49bd8e940dd06ae9e987bd65aee1b1467edd56ed84fcdcbdd44354bf613bdbb4e5d2913e925850368e150c59ed54c65"
GODOT_BIN="/usr/local/bin/godot"

step() {
	local name="$1"
	shift
	local start
	start="$(date +%s)"
	echo "== ${name}"
	"$@"
	echo "-- ${name}: $(($(date +%s) - start))s"
}

install_system_packages() {
	local need=()
	local pkg
	for pkg in unzip curl ca-certificates xvfb xauth; do
		if ! dpkg -s "$pkg" >/dev/null 2>&1; then
			need+=("$pkg")
		fi
	done
	if ((${#need[@]} == 0)); then
		echo "system packages already present"
		return 0
	fi
	sudo apt-get update
	sudo DEBIAN_FRONTEND=noninteractive apt-get install -y "${need[@]}"
}

install_godot() {
	if [[ -x "$GODOT_BIN" ]]; then
		local got
		got="$("$GODOT_BIN" --version 2>/dev/null | head -1 || true)"
		if [[ "$got" == 4.7.2.stable* ]]; then
			echo "Godot already installed: $got"
			rm -f "${HOME}/.local/bin/godot"
			return 0
		fi
		echo "replacing unexpected Godot: ${got:-missing}"
	fi
	local tmp archive
	tmp="$(mktemp -d)"
	archive="Godot_v${GODOT_VERSION}_linux.x86_64.zip"
	curl -fsSL --retry 3 -o "$tmp/$archive" \
		"https://github.com/godotengine/godot/releases/download/${GODOT_VERSION}/${archive}"
	echo "${GODOT_LINUX_SHA512}  $tmp/$archive" | sha512sum -c -
	unzip -q "$tmp/$archive" -d "$tmp/godot"
	sudo install -m 755 "$tmp/godot/Godot_v${GODOT_VERSION}_linux.x86_64" "$GODOT_BIN"
	rm -rf "$tmp"
	rm -f "${HOME}/.local/bin/godot"
	"$GODOT_BIN" --version
}

python_venv() {
	if [[ ! -x .venv/bin/python ]]; then
		python3 -m venv .venv
	fi
	PIP_DISABLE_PIP_VERSION_CHECK=1 .venv/bin/pip install -q -r tools/requirements-dev.txt
	.venv/bin/python -c "import PIL; print('Pillow', PIL.__version__)"
}

import_project() {
	local cache="${ROOT}/.godot/global_script_class_cache.cfg"
	if [[ -f "$cache" ]] && [[ -z "$(find "${ROOT}/scripts" "${ROOT}/tools" -name '*.gd' -newer "$cache" -print -quit)" ]]; then
		echo "class cache up to date"
		return 0
	fi
	godot --headless --path "$ROOT" --editor --import --quit
}

write_agent_notes() {
	local notes="${HOME}/.config/amp/AGENTS.md"
	local marker="# Herdstead (this orb)"
	mkdir -p "$(dirname "$notes")"
	if [[ -f "$notes" ]] && grep -Fqx "$marker" "$notes"; then
		echo "agent notes already present"
		return 0
	fi
	mkdir -p "$(dirname "$notes")"
	cat >>"$notes" <<'EOF'

# Herdstead (this orb)

- Godot 4.7.2 is `godot` on PATH (`/usr/local/bin/godot`), matching CI.
- Art and lint tools: `.venv/bin/python` with Pillow and gdtoolkit from `tools/requirements-dev.txt`.
- Read `AGENTS.md` first. Everything CI checks: `make check` (Godot + Python; no herdr); `make help` lists the rest. Live office needs a herdr socket this orb typically does not have.
- Do not download Godot export templates (~1.3 GB) unless exporting a macOS `.app`.
EOF
}

step "system packages" install_system_packages
step "godot ${GODOT_VERSION}" install_godot
step "python venv" python_venv
step "godot import" import_project
step "agent notes" write_agent_notes
echo "SETUP_OK"
