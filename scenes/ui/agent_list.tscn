[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/ui/agent_list.gd" id="1"]
[ext_resource type="PackedScene" path="res://scenes/ui/agent_list_row.tscn" id="2"]
[ext_resource type="PackedScene" path="res://scenes/ui/agent_list_group.tscn" id="3"]

[sub_resource type="ButtonGroup" id="ButtonGroup_view"]

[node name="AgentList" type="PanelContainer"]
offset_right = 144.0
offset_bottom = 160.0
focus_mode = 2
theme_type_variation = &"HdPanel"
script = ExtResource("1")
row_scene = ExtResource("2")
group_scene = ExtResource("3")

[node name="Frame" type="MarginContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/margin_left = 6
theme_override_constants/margin_top = 5
theme_override_constants/margin_right = 0
theme_override_constants/margin_bottom = 5

[node name="Body" type="VBoxContainer" parent="Frame"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 3

[node name="Heading" type="HBoxContainer" parent="Frame/Body"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 2

[node name="Title" type="Label" parent="Frame/Body/Heading"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
theme_type_variation = &"Heading13"
text = "AGENTS"
clip_text = true

[node name="Flat" type="Button" parent="Frame/Body/Heading"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
tooltip_text = "Flat: who needs you first, then who is working, idle, offline."
focus_mode = 0
theme_type_variation = &"ListSegment"
toggle_mode = true
button_pressed = true
button_group = SubResource("ButtonGroup_view")
text = "Flat"

[node name="Tree" type="Button" parent="Frame/Body/Heading"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
tooltip_text = "Tree: machine, floor, worktree mezzanine, tab, agent."
focus_mode = 0
theme_type_variation = &"ListSegment"
toggle_mode = true
button_group = SubResource("ButtonGroup_view")
text = "Tree"

[node name="Filter" type="LineEdit" parent="Frame/Body"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"ListFilter"
placeholder_text = "Filter"
tooltip_text = "Filter by agent, tab, floor or repository name."
clear_button_enabled = true

[node name="Scroll" type="ScrollContainer" parent="Frame/Body"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0
vertical_scroll_mode = 4

[node name="RowsGap" type="MarginContainer" parent="Frame/Body/Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
theme_type_variation = &"DrawerRowsGap"

[node name="Rows" type="VBoxContainer" parent="Frame/Body/Scroll/RowsGap"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
theme_override_constants/separation = 0

[node name="Empty" type="Label" parent="Frame/Body"]
unique_name_in_owner = true
visible = false
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"LabelSlate"
text = "No agents."

[node name="Actions" type="PopupMenu" parent="."]
unique_name_in_owner = true
