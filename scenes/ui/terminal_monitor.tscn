[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/ui/terminal_monitor.gd" id="1"]
[ext_resource type="Script" path="res://scripts/ui/hd_panel.gd" id="2"]
[ext_resource type="Script" path="res://scripts/ui/terminal_monitor_grid.gd" id="3"]

[node name="TerminalMonitor" type="Control"]
visible = false
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1")

[node name="Backdrop" type="Panel" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
theme_type_variation = &"MonitorBackdrop"

[node name="Bezel" type="PanelContainer" parent="."]
unique_name_in_owner = true
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 8.0
offset_top = 6.0
offset_right = -8.0
offset_bottom = -6.0
theme_type_variation = &"HdPanel"
script = ExtResource("2")

[node name="Frame" type="MarginContainer" parent="Bezel"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/margin_left = 6
theme_override_constants/margin_top = 4
theme_override_constants/margin_right = 6
theme_override_constants/margin_bottom = 4

[node name="Column" type="VBoxContainer" parent="Bezel/Frame"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 3

[node name="TitleBar" type="HBoxContainer" parent="Bezel/Frame/Column"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 6

[node name="Title" type="Label" parent="Bezel/Frame/Column/TitleBar"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 1
theme_type_variation = &"Heading13"
text = "TERMINAL"
clip_text = true
text_overrun_behavior = 3

[node name="SwitchNote" type="Label" parent="Bezel/Frame/Column/TitleBar"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
tooltip_text = "herdr's focus is shared, and it marks the whole tab seen: switching here clears UNREAD for every pane on this table."
mouse_filter = 1
theme_type_variation = &"LabelSlate"
text = "Clears table's UNREAD"

[node name="SwitchButton" type="Button" parent="Bezel/Frame/Column/TitleBar"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
focus_mode = 0
theme_type_variation = &"CardAction"
text = "Switch herdr here"

[node name="CloseButton" type="Button" parent="Bezel/Frame/Column/TitleBar"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
tooltip_text = "Close the monitor (Ctrl+]). Nothing is sent."
focus_mode = 0
theme_type_variation = &"CardAction"
text = "Close ✕"

[node name="Screen" type="PanelContainer" parent="Bezel/Frame/Column"]
layout_mode = 2
size_flags_vertical = 3
mouse_filter = 2
theme_type_variation = &"MonitorScreen"

[node name="Grid" type="Control" parent="Bezel/Frame/Column/Screen"]
unique_name_in_owner = true
clip_contents = true
layout_mode = 2
focus_mode = 2
theme_type_variation = &"MonitorGrid"
script = ExtResource("3")

[node name="StatusBar" type="HBoxContainer" parent="Bezel/Frame/Column"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 8

[node name="LiveMark" type="Label" parent="Bezel/Frame/Column/StatusBar"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 1
theme_type_variation = &"CardOutcome"
text = "● LIVE INPUT"

[node name="Latency" type="Label" parent="Bezel/Frame/Column/StatusBar"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 1
theme_type_variation = &"LabelSlate"

[node name="Message" type="Label" parent="Bezel/Frame/Column/StatusBar"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 1
theme_type_variation = &"LabelSlate"
clip_text = true
text_overrun_behavior = 3

[node name="FollowButton" type="Button" parent="Bezel/Frame/Column/StatusBar"]
unique_name_in_owner = true
visible = false
layout_mode = 2
tooltip_text = "Aim the monitor at the terminal that holds this pane now. Input comes back once its screen is shown."
focus_mode = 0
theme_type_variation = &"CardAction"
text = "Follow new terminal"
