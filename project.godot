; Live Herdr office, plus the mock art-pack showroom in scenes/preview.tscn.
config_version=5

[application]
config/name="Herdstead"
run/main_scene="res://scenes/office.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[debug]

; GDScript warnings are the cheapest gate this project has: a warning set to
; Error makes the script fail to compile, so tools/check_scripts.gd (and CI's
; "SCRIPT ERROR|Parse Error" greps) catch it on every run. Everything the code
; is clean of is an Error, so it cannot come back.
gdscript/warnings/unsafe_cast=2
gdscript/warnings/unused_variable=2
gdscript/warnings/unused_parameter=2
gdscript/warnings/shadowed_variable=2
gdscript/warnings/shadowed_variable_base_class=2
gdscript/warnings/shadowed_global_identifier=2
gdscript/warnings/narrowing_conversion=2
gdscript/warnings/static_called_on_instance=2
gdscript/warnings/missing_tool=2
gdscript/warnings/redundant_await=2
; The typing warnings. The art pack's JSON, the herdr snapshot and the test
; doubles are read through typed classes (scripts/art/, HerdrSnapshot,
; OfficeScene and tools/office_double.gd), so scripts/ and tools/ are at zero.
; Godot has no per-directory warning setting and check_scripts.gd loads tools/
; as well as scripts/, so both must stay at zero. No @warning_ignore is used anywhere.
gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_call_argument=2
; Off: well over a hundred under each of scripts/ and tools/, nearly all of
; them the engine's non-void Array/Dictionary/FileAccess calls.
gdscript/warnings/return_value_discarded=0
; Six deliberate integer divisions (grid rows, zoom fit, texture rescale). The
; only way to silence one is @warning_ignore, which hides the accidents too.
gdscript/warnings/integer_division=1
; `:=` is the house style, so inferred declarations are not a finding at all.
gdscript/warnings/inferred_declaration=0

[display]
window/size/viewport_width=800
window/size/viewport_height=480
window/size/window_width_override=1920
window/size/window_height_override=960
; The showroom uses this fixed base size with integer canvas scaling. The live
; office clears the base size and sets content_scale_factor to its integer zoom,
; keeping the entire window filled even when its dimensions are not multiples.
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"

[importer_defaults]

; Mipmaps follow the family (docs/ASSET_SPEC.md). A NEAREST family (the packs,
; their tables, the pixel people; all density 2) is only magnified by whole
; numbers and never reads a mip level, so a new PNG gets none by default. The
; one family the GPU still minifies (the agent logos) carries
; mipmaps/generate=true in its own .import. tools/test_art.gd checks both.
; docs/ and art/ are never imported.
texture={
"mipmaps/generate": false
}

[input]

; Every key and wheel button the office answers, so a binding is data the editor
; shows and remaps, not a keycode buried in _unhandled_input. Arrow-key panning
; keeps the engine's own ui_left/ui_right/ui_up/ui_down. Written by the editor's
; own serialisation; scripts/avatar_studio.gd still matches keycodes by hand.

office_zoom_in={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":61,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
